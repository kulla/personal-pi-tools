{
  "name": "pi-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run check:tsc && bun run check:format && bun run check:lint && bun run test",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:tsc": "tsc --noEmit",
    "fix": "bun run fix:lint && bun run fix:format && bun test",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "test": "bun test --only-failures"
  },
  "dependencies": {
    "@tsconfig/bun": "^1.0.12",
    "@types/bun": "^1.4.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@tsconfig/recommended": "^1.0.14",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
